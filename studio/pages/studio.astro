---
/**
 * The studio shell. Injected only by `studio/integration.mjs` when Astro is
 * running in dev, so this page has no counterpart in `dist/`.
 *
 * Deliberately standalone rather than wrapped in `src/layouts/Layout.astro` —
 * it is a tool, not a page of the site, and should not inherit the gallery's
 * chrome. It does borrow the site's colour tokens so it feels like the project.
 */
import DropZone from '../components/DropZone.astro';
import PhotoRow from '../components/PhotoRow.astro';
import SaveBar from '../components/SaveBar.astro';
import StudioHeader from '../components/StudioHeader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>photo studio</title>
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&display=swap"
    />
  </head>
  <body>
    <StudioHeader />

    <main class="shell">
      <DropZone />
      <div id="rows" class="rows" aria-live="polite"></div>
      <p id="empty" class="empty" hidden>Nothing in the library yet — drop an original above.</p>
    </main>

    <PhotoRow />
    <SaveBar />
    <div id="toasts" class="toasts" aria-live="assertive"></div>

    <script>
      import { initStudio } from '../client/main';

      initStudio();
    </script>

    <style is:global>
      :root {
        --bg: #faf9f7;
        --bg-elevated: #ffffff;
        --surface: #f1efea;
        --border: #e2dfd8;
        --text: #1a1a18;
        --text-dim: #6f6b63;
        --accent: #1a1a18;
        --danger: #a4331f;
        --ok: #2f6b46;
        --warn: #8a6116;
      }

      * {
        box-sizing: border-box;
      }

      /* The UA's `[hidden] { display: none }` loses to any author `display`
         rule, and several components here set one. Restore the attribute's
         meaning so toggling `.hidden` in TypeScript actually hides things. */
      [hidden] {
        display: none !important;
      }

      body {
        margin: 0;
        padding: 0 0 6rem;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 14px;
      }

      button {
        font: inherit;
        color: inherit;
        cursor: pointer;
      }

      input {
        font: inherit;
        color: inherit;
      }

      /* Toasts are created in TypeScript, so their styles cannot be scoped. */
      .toast {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--border);
        border-left-width: 3px;
        border-radius: 8px;
        background: var(--bg-elevated);
        box-shadow: 0 6px 24px rgb(0 0 0 / 10%);
        font-size: 0.82rem;
        line-height: 1.45;
      }

      .toast--ok {
        border-left-color: var(--ok);
      }

      .toast--error {
        border-left-color: var(--danger);
        color: var(--danger);
      }

      .toast button {
        margin-left: auto;
        padding: 0 0.2rem;
        border: none;
        background: none;
        font-size: 1rem;
        line-height: 1;
        opacity: 0.5;
      }

      .toast button:hover {
        opacity: 1;
      }
    </style>

    <style>
      .shell {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem;
      }

      .rows {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }

      .empty {
        margin: 3rem 0;
        color: var(--text-dim);
        text-align: center;
      }

      .toasts {
        position: fixed;
        right: 1rem;
        bottom: 5.5rem;
        z-index: 30;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: min(28rem, calc(100vw - 2rem));
      }
    </style>
  </body>
</html>

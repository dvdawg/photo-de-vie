---
/**
 * Appears once anything is dirty. Metadata edits are batched behind it so the
 * result is one commit-sized diff rather than a write per keystroke.
 */
---

<div id="savebar" class="bar" hidden>
  <span id="dirty-count" class="count"></span>
  <span class="path">src/data/library.json</span>
  <button id="revert" type="button" class="revert">Revert</button>
  <button id="save" type="button" class="save">Save changes</button>
</div>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 25;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 1100px;
    margin: 0 auto 1rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elevated);
    box-shadow: 0 8px 30px rgb(0 0 0 / 12%);
  }

  .count {
    font-weight: 500;
  }

  .path {
    color: var(--text-dim);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.78rem;
  }

  .revert,
  .save {
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .revert {
    margin-left: auto;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
  }

  .revert:hover {
    color: var(--text);
  }

  .save {
    border: none;
    background: var(--accent);
    color: #fff;
  }

  .save[disabled] {
    opacity: 0.5;
    cursor: default;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { photos, categorizedTags } from '../data/photos.ts';

const categories = categorizedTags();
---

<Layout>
  <header class="site-header">
    <div class="wrap header-inner">
      <h1>photo de vie</h1>

      <div class="tag-menu">
        <button
          class="tag-toggle"
          type="button"
          data-tag-toggle
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="tag-dropdown"
          aria-label="Filter by tag"
          title="Filter by tag"
        >
          <svg
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" />
            <circle cx="7" cy="7" r="1.25" fill="currentColor" stroke="none" />
          </svg>
        </button>

        <div class="tag-dropdown" id="tag-dropdown" data-tag-panel hidden role="menu">
          <div class="dropdown-head">
            <span>Filter by tag</span>
            <div class="match-toggle" role="group" aria-label="Match mode">
              <button type="button" class="match-btn is-active" data-mode="any">Any</button>
              <button type="button" class="match-btn" data-mode="all">All</button>
            </div>
          </div>

          {
            categories.map((category) => (
              <div class="tag-category">
                <p class="tag-category-name">{category.name}</p>
                <div class="tag-list" role="group" aria-label={category.name}>
                  {category.tags.map(({ tag, count }) => (
                    <button class="tag" type="button" data-tag={tag} aria-pressed="false">
                      {tag}
                      <span class="tag-count">{count}</span>
                    </button>
                  ))}
                </div>
              </div>
            ))
          }

          <div class="dropdown-foot">
            <button type="button" class="clear-btn" data-clear hidden>Clear all</button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="gallery" id="gallery" aria-label="Photo gallery">
      {
        photos.map((photo, i) => (
          <figure
            class="card"
            data-index={i}
            data-tags={photo.tags.join(' ')}
          >
            <button
              class="card-btn"
              type="button"
              aria-label={`Open ${photo.title}`}
              style={`aspect-ratio: ${photo.width} / ${photo.height};`}
            >
              <img
                src={photo.thumb ?? photo.src}
                alt={photo.title}
                loading="lazy"
                decoding="async"
                width={photo.width}
                height={photo.height}
              />
              <figcaption class="card-meta">
                <span class="card-title">{photo.title}</span>
                {photo.location && (
                  <span class="card-location">{photo.location}</span>
                )}
              </figcaption>
            </button>
          </figure>
        ))
      }
    </section>

    <p class="empty-state" data-empty hidden>
      No photos match those tags. Try fewer tags or switch to “Any”.
    </p>
  </main>

  <!-- Lightbox -->
  <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lb-close" data-lb-close type="button" aria-label="Close">✕</button>
    <button class="lb-nav lb-prev" data-lb-prev type="button" aria-label="Previous photo">‹</button>
    <button class="lb-nav lb-next" data-lb-next type="button" aria-label="Next photo">›</button>

    <figure class="lb-figure">
      <img class="lb-img" data-lb-img src="" alt="" />
      <figcaption class="lb-caption">
        <div class="lb-caption-main">
          <span class="lb-title" data-lb-title></span>
          <span class="lb-sub" data-lb-sub></span>
        </div>
        <div class="lb-tags" data-lb-tags></div>
      </figcaption>
    </figure>
  </div>

  <script
    type="application/json"
    id="photo-data"
    set:html={JSON.stringify(photos)}
  />
</Layout>

<style>
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  /* Header */
  .site-header {
    background: linear-gradient(180deg, var(--bg-elevated), var(--bg));
  }
  .header-inner {
    padding: clamp(1rem, 5vw, 2rem) clamp(1rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.01em;
  }

  /* Tag menu (header) */
  .tag-menu {
    position: relative;
    flex: none;
  }
  .tag-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tag-toggle svg {
    display: block;
  }
  .tag-toggle:hover {
    border-color: var(--text-dim);
  }
  .tag-toggle.has-active {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
  }

  /* Dropdown window */
  .tag-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 50;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(20, 18, 12, 0.16);
    transform-origin: top right;
    animation: dropdown-in 0.16s ease;
  }
  .tag-dropdown[hidden] {
    display: none;
  }
  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  .dropdown-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .dropdown-head > span {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .tag-category {
    margin-top: 0.85rem;
  }
  .tag-category-name {
    margin: 0 0 0.45rem;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tag:hover {
    border-color: var(--text-dim);
    color: var(--text);
  }
  .tag[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
    font-weight: 600;
  }
  .tag-count {
    font-size: 0.62rem;
    opacity: 0.55;
  }
  .tag[aria-pressed='true'] .tag-count {
    opacity: 0.8;
  }

  .dropdown-foot {
    margin-top: 1rem;
  }
  .dropdown-foot .clear-btn[hidden] {
    display: none;
  }

  .match-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }
  .match-btn {
    padding: 0.22rem 0.6rem;
    background: var(--surface);
    color: var(--text-dim);
    border: none;
    font-size: 0.72rem;
    cursor: pointer;
  }
  .match-btn.is-active {
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }
  .clear-btn {
    width: 100%;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-size: 0.78rem;
    cursor: pointer;
  }
  .clear-btn:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }

  /* Gallery — masonry via CSS columns */
  .gallery {
    column-count: 3;
    column-gap: 1rem;
    padding: 0.5rem 0 3rem;
  }
  @media (max-width: 1000px) {
    .gallery {
      column-count: 2;
    }
  }
  @media (max-width: 620px) {
    .gallery {
      column-count: 1;
    }
  }
  .card {
    margin: 0 0 1rem;
    break-inside: avoid;
    animation: fade-in 0.4s ease both;
  }
  .card[hidden] {
    display: none;
  }
  .card-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    background: var(--surface);
  }
  .card-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .card-btn:hover img {
    transform: scale(1.04);
  }
  .card-meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.9rem 0.8rem;
    text-align: left;
    color: #fff;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.78));
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.25s ease;
  }
  .card-btn:hover .card-meta,
  .card-btn:focus-visible .card-meta {
    opacity: 1;
    transform: translateY(0);
  }
  .card-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .card-location {
    display: block;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.8rem;
  }

  .empty-state {
    text-align: center;
    color: var(--text-dim);
    padding: 4rem 1rem;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .site-footer p {
    margin: 0;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(8, 8, 10, 0.94);
    backdrop-filter: blur(6px);
    color: #f0efed;
    animation: fade-in 0.2s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-figure {
    margin: 0;
    max-width: min(1200px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .lb-img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius);
    margin: 0 auto;
  }
  .lb-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    justify-content: space-between;
  }
  .lb-title {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .lb-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-left: 0.6rem;
  }
  .lb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .lb-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.72);
  }

  .lb-close,
  .lb-nav {
    position: fixed;
    z-index: 101;
    background: rgba(30, 30, 36, 0.7);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: #fff;
    color: #1a1a18;
  }
  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    font-size: 1rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.8rem;
    line-height: 1;
  }
  .lb-prev {
    left: 1.1rem;
  }
  .lb-next {
    right: 1.1rem;
  }
  .lb-nav[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 620px) {
    .lb-nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.4rem;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  interface PhotoRecord {
    id: string;
    src: string;
    thumb?: string;
    title: string;
    location?: string;
    year?: number;
    tags: string[];
    width: number;
    height: number;
  }

  const data: PhotoRecord[] = JSON.parse(
    document.getElementById('photo-data')?.textContent ?? '[]'
  );

  const gallery = document.getElementById('gallery')!;
  const cards = Array.from(gallery.querySelectorAll<HTMLElement>('.card'));
  const tagButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.tag')
  );
  const matchButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.match-btn')
  );
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
  const tagToggle = document.querySelector<HTMLButtonElement>('[data-tag-toggle]')!;
  const tagMenu = document.querySelector<HTMLElement>('.tag-menu')!;
  const tagPanel = document.querySelector<HTMLElement>('[data-tag-panel]')!;

  const active = new Set<string>();
  let matchMode: 'any' | 'all' = 'any';

  /** Indices (into `data`) of cards currently visible, in DOM order. */
  let visible: number[] = [];

  function matches(tags: string[]): boolean {
    if (active.size === 0) return true;
    const tagSet = new Set(tags);
    if (matchMode === 'all') {
      for (const t of active) if (!tagSet.has(t)) return false;
      return true;
    }
    for (const t of active) if (tagSet.has(t)) return true;
    return false;
  }

  function applyFilter(): void {
    visible = [];
    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
      const show = matches(tags);
      card.hidden = !show;
      if (show) visible.push(Number(card.dataset.index));
    }

    emptyEl.hidden = visible.length > 0;
    clearBtn.hidden = active.size === 0;
    tagToggle.classList.toggle('has-active', active.size > 0);
    syncUrl();
  }

  function setPanel(open: boolean): void {
    tagPanel.hidden = !open;
    tagToggle.setAttribute('aria-expanded', String(open));
  }

  tagToggle.addEventListener('click', () => {
    setPanel(tagPanel.hidden);
  });

  // Close the dropdown on outside click or Escape.
  document.addEventListener('click', (e) => {
    if (!tagPanel.hidden && !tagMenu.contains(e.target as Node)) setPanel(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !tagPanel.hidden) {
      setPanel(false);
      tagToggle.focus();
    }
  });

  function syncUrl(): void {
    const params = new URLSearchParams();
    if (active.size > 0) params.set('tags', [...active].join(','));
    if (matchMode === 'all') params.set('match', 'all');
    const qs = params.toString();
    const url = qs ? `?${qs}` : location.pathname;
    history.replaceState(null, '', url);
  }

  function readUrl(): void {
    const params = new URLSearchParams(location.search);
    const tags = params.get('tags');
    if (tags) {
      for (const t of tags.split(',').map((s) => s.trim()).filter(Boolean)) {
        active.add(t);
      }
    }
    if (params.get('match') === 'all') matchMode = 'all';
  }

  // --- Tag interactions ---
  for (const btn of tagButtons) {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag!;
      if (active.has(tag)) active.delete(tag);
      else active.add(tag);
      btn.setAttribute('aria-pressed', String(active.has(tag)));
      applyFilter();
    });
  }

  for (const btn of matchButtons) {
    btn.addEventListener('click', () => {
      matchMode = btn.dataset.mode as 'any' | 'all';
      for (const b of matchButtons) b.classList.toggle('is-active', b === btn);
      applyFilter();
    });
  }

  clearBtn.addEventListener('click', () => {
    active.clear();
    for (const b of tagButtons) b.setAttribute('aria-pressed', 'false');
    applyFilter();
  });

  // --- Lightbox ---
  const lb = document.querySelector<HTMLElement>('[data-lightbox]')!;
  const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const lbTitle = lb.querySelector<HTMLElement>('[data-lb-title]')!;
  const lbSub = lb.querySelector<HTMLElement>('[data-lb-sub]')!;
  const lbTags = lb.querySelector<HTMLElement>('[data-lb-tags]')!;
  const lbPrev = lb.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
  const lbNext = lb.querySelector<HTMLButtonElement>('[data-lb-next]')!;
  const lbClose = lb.querySelector<HTMLButtonElement>('[data-lb-close]')!;

  /** Position within `visible` of the photo currently shown. */
  let pos = -1;
  let lastFocused: HTMLElement | null = null;

  function render(): void {
    const photo = data[visible[pos]];
    if (!photo) return;
    lbImg.src = photo.src;
    lbImg.alt = photo.title;
    lbTitle.textContent = photo.title;
    const sub = [photo.location, photo.year].filter(Boolean).join(' · ');
    lbSub.textContent = sub;
    lbSub.hidden = !sub;
    lbTags.innerHTML = '';
    for (const t of photo.tags) {
      const span = document.createElement('span');
      span.className = 'lb-tag';
      span.textContent = t;
      lbTags.appendChild(span);
    }
    lbPrev.disabled = pos <= 0;
    lbNext.disabled = pos >= visible.length - 1;
  }

  function openAt(index: number): void {
    pos = visible.indexOf(index);
    if (pos === -1) return;
    lastFocused = document.activeElement as HTMLElement;
    lb.hidden = false;
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    render();
    lbClose.focus();
  }

  function close(): void {
    lb.hidden = true;
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  function step(delta: number): void {
    const next = pos + delta;
    if (next < 0 || next >= visible.length) return;
    pos = next;
    render();
  }

  for (const card of cards) {
    const btn = card.querySelector<HTMLButtonElement>('.card-btn')!;
    btn.addEventListener('click', () => openAt(Number(card.dataset.index)));
  }

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => step(-1));
  lbNext.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });

  // --- Init ---
  readUrl();
  for (const btn of tagButtons) {
    btn.setAttribute('aria-pressed', String(active.has(btn.dataset.tag!)));
  }
  for (const b of matchButtons) {
    b.classList.toggle('is-active', b.dataset.mode === matchMode);
  }
  setPanel(false);
  applyFilter();
</script>

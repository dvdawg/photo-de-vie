---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import PhotoFilters from '../components/PhotoFilters.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { photos, categorizedTags } from '../data/photos';

const categories = categorizedTags();
---

<Layout>
  <PhotoFilters />

  <SiteHeader categories={categories} />

  <main class="wrap">
    <Gallery photos={photos} />
  </main>

  <Lightbox />
</Layout>

<script>
  import { initGallery } from '../scripts/gallery';
  import { initViewMode } from '../scripts/viewMode';
  import { initLightboxView } from '../scripts/lightboxView';

  initViewMode();
  initLightboxView();
  initGallery();
</script>

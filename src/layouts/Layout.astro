---
import '../styles/tailwind.css';
import '@fontsource-variable/newsreader/standard.css';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-standard-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'photo de vie',
  description = 'dvd photography gallery',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/dvd.png" />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=plein@1&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf9f7;
    --bg-elevated: #ffffff;
    --surface: #f1efea;
    --border: #e2dfd8;
    --text: #1a1a18;
    --text-dim: #74716a;
    --accent: #1a1a18;
    --accent-contrast: #ffffff;
    --radius: 10px;
    --maxw: 1400px;
    --font-display: 'Newsreader Variable', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    --font-body: 'Plein', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-family: var(--font-body);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  button,
  input,
  select,
  textarea {
    font-family: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  /* Reserve the photo's space while it downloads and decodes. Without JS,
     images remain visible and retain native lazy loading. */
  .js img[data-photo]:not([data-photo-state='ready']):not([data-photo-state='error']) {
    opacity: 0;
  }

  ::selection {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  /* Shared page gutter, used by the header and the gallery alike. */
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }

  /* Animations referenced from more than one component. */
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

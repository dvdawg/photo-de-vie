---
/**
 * Full-view photo viewer. Markup only — navigation lives in
 * `scripts/gallery.ts`, and the per-photo treatment in `scripts/lightboxView.ts`.
 */
import LightboxControls from './LightboxControls.astro';
---

<div
  class="lightbox"
  data-lightbox
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
>
  <LightboxControls />

  <button class="lb-close" data-lb-close type="button" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" data-lb-prev type="button" aria-label="Previous photo">‹</button>
  <button class="lb-nav lb-next" data-lb-next type="button" aria-label="Next photo">›</button>

  <figure class="lb-figure">
    <div class="lb-frame">
      <img class="lb-img" data-lb-img src="" alt="" />
      <img class="lb-blend" data-lb-blend alt="" aria-hidden="true" />
    </div>
    <figcaption class="lb-caption">
      <div class="lb-caption-main">
        <span class="lb-counter" data-lb-counter></span>
        <span class="lb-title" data-lb-title></span>
        <span class="lb-sub" data-lb-sub></span>
      </div>
    </figcaption>
  </figure>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(8, 8, 10, 0.94);
    backdrop-filter: blur(6px);
    color: #f0efed;
    animation: fade-in 0.2s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-figure {
    margin: 0;
    max-width: min(1200px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /*
   * `width: fit-content` shrink-wraps the frame to the displayed image, so the
   * blend plate's `inset: 0` lines up with the photograph rather than with the
   * full width of the viewer.
   */
  .lb-frame {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    isolation: isolate;
    /* Clips the partner once it is scaled past the edges of the photograph. */
    overflow: hidden;
  }
  .lb-img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
  }
  /*
   * `contain` preserves the partner's own aspect ratio — it is never stretched.
   * Scale and offset then let the viewer size and place it, so a mismatched
   * pair can be made to fill the frame instead of leaving hard letterbox edges.
   * `scripts/lightboxView.ts` defaults the scale to whatever covers the frame.
   */
  .lb-blend {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: screen;
    opacity: var(--lb-blend-amount, 0.65);
    transform: translate(var(--lb-blend-x, 0%), var(--lb-blend-y, 0%))
      scale(var(--lb-blend-scale, 1));
    display: none;
  }
  :global([data-lb-mode='double']) .lb-blend {
    display: block;
  }

  .lb-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .lb-counter {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
    font-variant-numeric: tabular-nums;
    margin-right: 0.7rem;
  }
  .lb-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
  }
  .lb-sub {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-left: 0.6rem;
  }
  .lb-sub[hidden] {
    display: none;
  }

  .lb-close,
  .lb-nav {
    position: fixed;
    z-index: 101;
    background: rgba(30, 30, 36, 0.7);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: #fff;
    color: #1a1a18;
  }
  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    font-size: 1rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.8rem;
    line-height: 1;
  }
  .lb-prev {
    left: 1.1rem;
  }
  .lb-next {
    right: 1.1rem;
  }
  .lb-nav[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 620px) {
    .lb-nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.4rem;
    }
  }
</style>

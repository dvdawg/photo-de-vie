---
import type { CategorizedTag } from '../data/photos';

interface Props {
  categories: CategorizedTag[];
}

const { categories } = Astro.props;
---

<div class="tag-menu">
  <button
    class="tag-toggle"
    type="button"
    data-tag-toggle
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="tag-dropdown"
    aria-label="Filter by tag"
    title="Filter by tag"
  >
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" />
      <circle cx="7" cy="7" r="1.25" fill="currentColor" stroke="none" />
    </svg>
  </button>

  <div class="tag-dropdown" id="tag-dropdown" data-tag-panel hidden role="menu">
    {
      categories.map((category, index) => (
        <div class="tag-category">
          <div class="tag-category-head">
            <p class="tag-category-name">{category.name}</p>
            {index === 0 && (
              <div class="match-toggle" role="group" aria-label="Match mode">
                <button type="button" class="match-btn is-active" data-mode="any">Any</button>
                <button type="button" class="match-btn" data-mode="all">All</button>
              </div>
            )}
          </div>
          <div class="tag-list" role="group" aria-label={category.name}>
            {category.tags.map(({ tag, count }) => (
              <button class="tag" type="button" data-tag={tag} aria-pressed="false">
                {tag}
                <span class="tag-count">{count}</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }

    <div class="dropdown-foot">
      <button type="button" class="clear-btn" data-clear hidden>Clear all</button>
    </div>
  </div>
</div>

<style>
  .tag-menu {
    position: relative;
    flex: none;
  }
  .tag-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: color 0.15s ease, opacity 0.15s ease;
  }
  .tag-toggle svg {
    display: block;
  }
  .tag-toggle:hover {
    opacity: 0.7;
  }
  .tag-toggle.has-active {
    color: var(--accent);
  }

  .tag-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 50;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 0;
    box-shadow: 0 12px 40px rgba(20, 18, 12, 0.16);
    transform-origin: top right;
    animation: dropdown-in 0.16s ease;
    font-family: var(--font-body);
  }
  .tag-dropdown[hidden] {
    display: none;
  }

  .tag-category {
    margin-top: 0.85rem;
  }
  .tag-category:first-child {
    margin-top: 0;
  }
  .tag-category-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }
  .tag-category-name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-dim);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tag:hover {
    border-color: var(--text-dim);
    color: var(--text);
  }
  .tag[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
    font-weight: 600;
  }
  .tag-count {
    font-size: 0.62rem;
    opacity: 0.55;
  }
  .tag[aria-pressed='true'] .tag-count {
    opacity: 0.8;
  }

  .dropdown-foot {
    margin-top: 1rem;
  }
  .dropdown-foot .clear-btn[hidden] {
    display: none;
  }

  .match-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 0;
    overflow: hidden;
  }
  .match-btn {
    padding: 0.12rem 0.4rem;
    background: var(--surface);
    color: var(--text-dim);
    border: none;
    font-family: var(--font-body);
    font-size: 0.6rem;
    line-height: 1.2;
    cursor: pointer;
  }
  .match-btn.is-active {
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }
  .clear-btn {
    width: 100%;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 0.78rem;
    cursor: pointer;
  }
  .clear-btn:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }
</style>

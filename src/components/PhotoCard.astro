---
import type { Photo } from '../data/photos';

interface Props {
  photo: Photo;
  /** Index into the photo library, used to tie the card to the lightbox. */
  index: number;
}

const { photo, index } = Astro.props;
---

<figure class="card" data-index={index} data-tags={photo.tags.join(' ')}>
  <button
    class="card-btn"
    type="button"
    aria-label={`Open ${photo.title}`}
    style={`aspect-ratio: ${photo.width} / ${photo.height};`}
  >
    <img
      class="plate"
      src={photo.thumb ?? photo.src}
      alt={`${photo.title} — ${photo.tags.join(', ')}`}
      loading="lazy"
      decoding="async"
      width={photo.width}
      height={photo.height}
    />

    <!--
      Second plate for double-exposure mode. `src` is deliberately absent: the
      partner frames are only fetched once that mode is switched on, so the
      default gallery still loads exactly one image per card.
    -->
    <img class="blend-plate" data-blend alt="" aria-hidden="true" decoding="async" />

    <figcaption class="card-meta">
      <span class="card-title">{photo.title}</span>
      {photo.location && <span class="card-location">{photo.location}</span>}
    </figcaption>
  </button>
</figure>

<style>
  .card {
    margin: 0 0 1rem;
    break-inside: avoid;
    animation: fade-in 0.4s ease both;
  }
  .card[hidden] {
    display: none;
  }

  .card-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    overflow: hidden;
    cursor: pointer;
    background: var(--surface);
    /* Contains the blend plate so it composites against its own photograph
       rather than the page behind it. */
    isolation: isolate;
  }
  .plate {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .card-btn:hover .plate {
    transform: scale(1.03);
  }

  .blend-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
    display: none;
  }
  :global([data-view-mode='double']) .blend-plate {
    display: block;
  }

  .card-meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.9rem 0.8rem;
    text-align: left;
    color: #fff;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.78));
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.25s ease;
  }
  .card-btn:hover .card-meta,
  .card-btn:focus-visible .card-meta {
    opacity: 1;
    transform: translateY(0);
  }
  .card-title {
    display: block;
    font-family: var(--font-body);
    font-size: 0.95rem;
  }
  .card-location {
    display: block;
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.8rem;
  }
</style>
